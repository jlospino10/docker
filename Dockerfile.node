FROM node:20-bullseye

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  gnupg \
  wget \
  chromium \
  fonts-liberation \
  libappindicator3-1 \
  libasound2 \
  libatk-bridge2.0-0 \
  libgtk-3-0 \
  libx11-6 \
  libxcomposite1 \
  libxdamage1 \
  libxrandr2 \
  libgbm1 \
  && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_DOWNLOAD=false

WORKDIR /usr/src/app

# Copy entrypoint for cloning node apps
COPY node-entrypoint.sh /usr/local/bin/node-entrypoint.sh
RUN chmod +x /usr/local/bin/node-entrypoint.sh

# Do not copy application code; entrypoint will clone repos into /usr/src/apps
ENV APPS_DIR=/usr/src/apps

ENTRYPOINT ["/usr/local/bin/node-entrypoint.sh"]
CMD ["sh", "-c", "echo 'No default start command. Enter container and run your app.' && sleep infinity"]
